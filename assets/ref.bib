@inproceedings{nafee2026validation,
  title={Validation of Smartwatch-Based Pulse Rate Variability Metrics for HRV Assessment},
  author={Nafee, K. S. and Wang, F. and Cai, A. and Panapakam, V. K. and Ziadeh, Y. and Dang, J. and Beversdorf, D. and Ferguson, B.},
  booktitle={IEEE-EMBS International Conference on Biomedical and Health Informatics},
  address={Hong Kong, China},
  year={2026},
  abstract={Heart rate variability (HRV) is traditionally derived from electrocardiogram (ECG) data and serves as a noninvasive marker of autonomic nervous system activity. While modern smartwatches enable real-time pulse rate variability (PRV) monitoring via photoplethysmography (PPG), the reliability and interchangeability of these smartwatch-derived metrics remain uncertain. In this study, we first evaluated our custom PRV pipeline against Kubios Scientific HRV using gold-standard BIOPAC ECG data. We then compared Apple Watch 8- and Samsung Watch 8-derived PRV metrics from our pipeline against same-session BIOPAC ECG metrics from Kubios. Seven participants (five male, two female) contributed four 15-minute sessions each, yielding 28 segment pairs per comparison. A total of 15 time-domain and 18 frequency-domain HRV metrics were computed using Kubios-aligned algorithms. Agreement was evaluated using Pearson correlation for similarity and Bland-Altman agreement analysis for interchangeability. For BIOPAC ECG data, our pipeline showed Pearson correlations greater than 0.85 for 9 of 15 time-domain metrics and 15 of 18 frequency-domain metrics against Kubios results. For smartwatch interchangeability, a two-step procedure (Pearson r ≥ 0.70 screening and Bland-Altman agreement against an a priori limit of agreement) showed that 16/33 Apple Watch and 10/33 Samsung Watch metrics agreed with the Kubios ECG reference under the permissive 150% criterion, and 6/33 and 4/33, respectively, under the stricter 110% criterion. These preliminary results show that our PRV analysis pipeline aligns closely with Kubios, while smartwatch interchangeability is metric- and smartwatch-specific rather than universal.},
  note={Submitted}
}

@inproceedings{larson2026spatial,
  title={Spatial cognition versus language: What best differentiates autistic and neurotypical individuals?},
  author={Larson, C. and Dang, J. and Hirni, M. and Vulchanova, M.},
  booktitle={The Annual Meeting of the International Society for Autism Research (ASHA)},
  address={Prague, Czech Republic},
  year={2026},
  abstract={Background: Language and spatial cognition are highly heterogeneous in autism, and a growing
body of evidence indicates that these skills represent key autism versus neurotypical (NT)
diﬀerentiating characteristics (e.g., Bochynska et al., 2020). Moreover, studies suggest that
language and spatial cognition systems may be less integrated in autism (e.g., Bochynska et al.,
2020; Wallace et al., 2020), such as observed dissociations between grammar and mental
rotation performance in autistic individuals relative to NT peers (Larson et al., 2024; Larson et
al., 2025). However, little is known what language and spatial cognition abilities contribute to
group diﬀerentiation, nor the degree to which a broader set of language and spatial cognition
abilities are associated in autism versus NT peers.
Objectives: This study administered a battery of language and spatial cognition measures to
identify skills that best diﬀerentiate autistic from NT peers and to examine correlations among
these measures in autistic versus NT individuals.
Methods: Participants with autism spectrum disorder (n = 25; age M = 17.96, SD = 5.9) and age-
and nonverbal ability- matched NT controls (n = 25; age M = 17.80, SD = 5.3). Spatial cognition
tasks were: Spatial Perspective Taking, Mental Rotation, Spatial Naming, Spatial Verbal Memory
and Rotating Board Spatial Referencing. Language measures were: sub- and composite- scales
from the Test of Language Development (e.g., grammar, vocabulary). We also administered
verbal and nonverbal IQ measures. We identified predictors of group status via Elastic net
regression with cross-validation using Lasso and Ridge penalties to account for multiple
correlated predictors. Planned follow-up analyses also characterized the nature of correlations
among variables to evaluate the degree to which these skills are associated in autistic versus NT
individuals.
Results: The optimal model of group status (p < .05) included: age (b = -0.018), verbal (b =
0.001) and nonverbal IQ (b = -0.006), processing speed (b = 0.001), language – word ordering (b
= 0.034) and grammar (b = 0.071), spatial cognition – spatial verbal memory (b = 0.780),
rotating board spatial referencing (egocentric [b = -0.078] and absolute [b = -0.107]). Spatial
verbal memory was the strongest diﬀerentiating factor. Convergently, spatial verbal memory was
more strongly associated with word ordering, grammar, and rotating board spatial referencing in
the neurotypical (r’s > .29) than autistic group (r’s < .06).
Conclusions: This study suggests that both language and spatial cognition contribute to
diﬀerentiating autism versus NT status. The strongest predictor of group status was at the
intersection of language, spatial cognition, and general processing abilities – spatial verbal
memory – suggesting that the domain-general and domain-specific abilities represent key
considerations in autism. This finding also indicates that individual skills AND their associations
are important features of the neurodiverse autistic profile.
This study also revealed diﬀerences in how language and spatial cognition abilities are
associated in autism versus NT individuals. Spatial verbal memory, the strongest predictor of
group status, was associated with language and other spatial skills to a greater degree in NT
than autistic individuals. This finding suggests that the ability to integrate language and spatial
cognition within a task reflects the organization of language and spatial systems more broadly.
One implication of this work is that autistic individuals may face particular barriers when tasks
demand integrating language and spatial skills, such as integrating verbal and nonverbal
communication in social contexts. Future research should further examine how integrating
language and spatial cognition skills aﬀects the organization of each system in autism,
especially with measures that capture daily functioning demands.}
  note={Poster presentation}
}

